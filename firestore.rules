rules_version = '2';

// Copy into Firebase Console → Firestore Database → Rules → Publish.
// Merge with any existing rules (for example if you add custom claims for admin).
// Tighten `read` later (e.g. only `published` docs) if you need to hide drafts.

service cloud.firestore {
  match /databases/{database}/documents {
    match /itineraries/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /products/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /blog_posts/{docId} {
      allow read: if request.auth != null || resource.data.published == true;
      allow create, update, delete: if request.auth != null;
    }
    match /newsletter_subscribers/{docId} {
      allow read, delete: if request.auth != null;
      allow create, update: if
        request.resource.data.keys().hasOnly(['email', 'locale', 'source', 'subscribedAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.locale in ['en', 'pt'] &&
        request.resource.data.source == 'blog' &&
        request.resource.data.subscribedAt is timestamp;
    }
    match /ugc_posts/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /site_settings/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /trip_packages/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    // Leads from the public "Plan my trip" form: anyone can create one
    // well-formed enquiry; only the signed-in admin can read or change them.
    match /trip_enquiries/{docId} {
      allow read, update, delete: if request.auth != null;
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'tripSlug', 'tripTitle', 'destinations', 'travelMonth', 'nights', 'travellers', 'budget', 'interests', 'message', 'marketingOptIn', 'status', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 4000 &&
        request.resource.data.destinations is list &&
        request.resource.data.destinations.size() <= 12 &&
        request.resource.data.interests is list &&
        request.resource.data.interests.size() <= 12 &&
        request.resource.data.marketingOptIn is bool &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt is timestamp;
    }
    match /media_assets/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
